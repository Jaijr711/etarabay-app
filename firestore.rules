rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  E-Tarabay Firestore security rules
//
//  IMPORTANT ROLLOUT ORDER (do NOT deploy these until all are true):
//   1. Enable the "Anonymous" sign-in provider in Firebase Console
//      (Authentication → Sign-in method → Anonymous → Enable).
//   2. Release an app build that signs in anonymously at startup
//      (already added in main.dart) and let users update.
//   3. Only then deploy these rules. Deploying earlier will break every
//      currently-installed copy of the app (they don't authenticate).
//
//  These rules require an authenticated app instance (anonymous is fine),
//  which blocks arbitrary public internet access to the database while
//  keeping the current app behaviour working.
//
//  KNOWN LIMIT (data privacy): every copy of the app signs in anonymously,
//  the teacher's included, so these rules cannot tell the teacher from a
//  child's device. Any installed copy of the app can therefore read every
//  child's record. Closing that needs the teacher to sign in with an
//  account of their own (Firebase Email/Password, created by the
//  developers) and rules that check it — deliberately left for later.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Student records: readable/writable by any authenticated app instance.
    match /students/{studentId} {
      allow read, write: if request.auth != null;

      // The child's drawings (students/{id}/extra/creations). A match on a
      // document does not reach the documents under it, so without this the
      // catch-all below refused every drawing the moment these rules were
      // deployed.
      match /{sub=**} {
        allow read, delete: if request.auth != null;
        // Only under a child who still has a record. An offline phone that
        // drew while the child was being removed sent its drawings once the
        // signal came back, and they sat in the cloud under nobody. (The
        // removal itself deletes both in one batch, which these rules judge
        // against the record as it stood, so it still goes through.)
        allow create, update: if request.auth != null &&
          exists(/databases/$(database)/documents/students/$(studentId));
      }
    }

    // App config (teacher credential hash, developer dashboard password
    // hash): readable and writable by any authenticated app instance,
    // the same as everything else in this file — see the top-level note
    // on why that is the whole security model here. Only ever a one-way
    // password hash, never plaintext (see AuthService.hashLrn).
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
